# Copy this file to .env.local only when you need to override defaults.
# Never commit .env.local. Blank values use the application defaults documented
# in docs/CONFIGURATION.md.

# Runtime modes
SCENE_FIRST_PUBLIC_MODE=
SCENE_FIRST_LOCAL_MASTER=
SCENE_FIRST_POSE_AVATAR_OVERLAY=

# Detection and processing limits
MAX_IMAGE_PIXELS=
MAX_DETECTION_PIXELS=
DETECTION_TILE_MIN_EDGE=
DETECTION_ENABLE_TILES=
MAX_PARALLEL_PERSON_EDITS=

# Optional BYOK providers. You obtain and pay for these credentials.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
FAL_KEY=
FAL_IMAGE_MODEL=
ARK_API_KEY=
ARK_IMAGE_BASE_URL=
ARK_IMAGE_MODEL=
BFL_API_KEY=
BFL_IMAGE_MODEL=
DASHSCOPE_API_KEY=
QWEN_IMAGE_MODEL=

# Optional local cost-ledger estimates; these are not live prices.
OPENAI_ESTIMATED_CNY=
GEMINI_ESTIMATED_CNY=
FAL_ESTIMATED_CNY=
ARK_ESTIMATED_CNY=
BFL_ESTIMATED_CNY=
QWEN_ESTIMATED_CNY=
ARK_BILLING_MODE=
COST_LEDGER_USD_CNY=

# Optional access controls used by self-hosted Cloudflare deployments.
# Configure these as deployment secrets, not plain wrangler vars.
SCENE_FIRST_TEST_PASSWORD=
SCENE_FIRST_ADMIN_RESTART_TOKEN=

# Manual staging verification only; not read by the application.
SCENE_FIRST_STAGING_URL=
SCENE_FIRST_STAGING_ACCESS_CODE=
SCENE_FIRST_TEST_PROXY=
SCENE_FIRST_TEST_PROXY_USERNAME=
SCENE_FIRST_TEST_PROXY_PASSWORD=
